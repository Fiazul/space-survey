class_name SystemDB
extends RefCounted
# The STAR CATALOGUE you travel. Each system is its own star-centred frame in km
# (1 scene unit = 1 km, Newton, anchored positions — docs/adr/0002): Sol from JPL/NASA
# (SolEphemeris), every other star generated at real scale from its row + seed
# (GeneratedEphemeris). You never fly the real interstellar distance; the light-year
# distance + sky coordinates are display/transit/map metadata only.
#
# Two data sources, unified by id (see _rows):
#   • STARS    — ~45 REAL nearest stars (generated by tools/gen_star_catalog.py from the
#                J2000 nearest-star table). Each cooks from spectral type.
#   • AUTHORED — rows with hand-set metadata (Sol, Proxima, TRAPPIST-1, K2-18, the imaginary
#                Alien zone); their worlds are generated like every other star's.
#
# A "body spec" is what PlanetSystem.load_system() consumes (see sol_from): name,
# radius (km), color, glow, model (opt GLB/OBJ), star (bool), parent (moons).
# Positions always come from the system's ephemeris.

const SOL := "sol"
const K2_18 := "k2-18"
const PROXIMA := "proxima"
const TRAPPIST := "trappist"
const ALIEN := "alien"           # the hostile combat zone (Vortex + aliens)

